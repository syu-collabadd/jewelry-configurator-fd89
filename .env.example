# OpenAI API key (optional). If unset, the backend uses a deterministic mock
# interpreter so the demo runs without a key.
OPENAI_API_KEY=

# Override the OpenAI model used for structured interpretation.
OPENAI_MODEL=gpt-4o-mini-2024-07-18

# Backend port. Burrow Path B injects PORT into the process; the app reads it.
PORT=8046
